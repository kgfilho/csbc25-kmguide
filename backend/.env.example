# Chaves da API Groq (usadas pelos agentes CrewAI).
# GROQ_API_KEY_01 é obrigatória. GROQ_API_KEY_02 é opcional — se deixada em
# branco, os agentes reaproveitam a primeira chave. As duas chaves existem
# apenas para distribuir a carga entre contas e reduzir o risco de esbarrar
# no limite de requisições da Groq.
GROQ_API_KEY_01=
GROQ_API_KEY_02=

# Chave da API do YouTube Data v3
YOUTUBE_API_KEY=
